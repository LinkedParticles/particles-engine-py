/*
 * The core's executable contract: for every example card, the
 * view the core produces, and for every action the forms it asks, the
 * scripted answers, the exact requests and the result. A client that cannot
 * import this package checks itself against fixtures/contract.json.
 */
import {
  type CurationCard,
  type WireRequest,
  cardView,
  failureOf,
  memberCard,
  swipeGesture,
} from "../src/index.ts";
import { engineFor, loadCards, run, scriptedAnswer, type Trace } from "./harness.mts";

function traceData(t: Trace) {
  return {
    forms: t.forms.map((form) => ({ form, answer: scriptedAnswer(form) })),
    requests: t.requests,
    result: t.error === undefined ? { resolved: t.resolved, ...(t.notice ? { notice: t.notice } : {}) } : failureOf(t.error),
  };
}

const FAILURES: [number, unknown][] = [
  [401, {}],
  [403, { detail: "Belief writes are disabled for store 'default'." }],
  [404, { detail: "No open card with key 'stale:errors'." }],
  [500, {}],
  [503, { detail: "This engine has no PARTICLES_API_KEY, so it serves reads only." }],
];

export async function buildContract() {
  const cards: Record<string, unknown> = {};
  for (const card of loadCards()) {
    const view = cardView(card, { readOnly: false });
    const actions: Record<string, unknown> = {};
    for (const a of view.actions.filter((x) => x.enabled)) {
      actions[a.gesture] = {
        confirm: traceData(await run(a.gesture, structuredClone(card), engineFor(card))),
        cancel: traceData(await run(a.gesture, structuredClone(card), engineFor(card), "cancel")),
      };
    }
    const entry: Record<string, unknown> = {
      card,
      view,
      readOnlyView: cardView(card, { readOnly: true }),
      actions,
      swipe: { right: swipeGesture(card, "right", false), left: swipeGesture(card, "left", false) },
    };
    if (card.kind === "subjectless_source" && card.particles?.length) {
      const member = memberCard(card, card.particles[0]);
      const members: Record<string, unknown> = {};
      for (const g of ["assign-subject", "supersede", "retract"]) {
        members[g] = traceData(await run(g, member, engineFor(card)));
      }
      entry.member = { card: member, actions: members };
    }
    cards[card.fixture] = entry;
  }
  const plain = loadCards().find((c) => c.key === "stale:errors") as CurationCard;
  const failures: Record<string, unknown> = {};
  for (const [status, body] of FAILURES) {
    const t = await run("affirm", structuredClone(plain), (_req: WireRequest) => ({ status, body }));
    failures[String(status)] = { answer: { status, body }, ...traceData(t) };
  }
  return {
    comment:
      "The curation core's contract, generated by `npm run fixtures`. " +
      "Every client renders `view` and must send `requests` for the scripted `answer`s.",
    cards,
    failures,
  };
}
