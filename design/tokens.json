{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Particles design tokens (W3C design-token JSON). Mirror of tokens.css — keep equal.",
  "color": {
    "page":         { "$type": "color", "$value": "#f6f8fb", "$extensions": { "dark": "#0b1020" } },
    "surface":      { "$type": "color", "$value": "#ffffff", "$extensions": { "dark": "#141b2e" } },
    "surface-2":    { "$type": "color", "$value": "#eef2f7", "$extensions": { "dark": "#1b2540" } },
    "surface-3":    { "$type": "color", "$value": "#e3e9f2", "$extensions": { "dark": "#243052" } },
    "border":       { "$type": "color", "$value": "#d8dfe9", "$extensions": { "dark": "#2a3552" } },
    "border-strong":{ "$type": "color", "$value": "#b9c4d4", "$extensions": { "dark": "#3b4a70" } },
    "text":         { "$type": "color", "$value": "#1c2733", "$extensions": { "dark": "#e6edf3" } },
    "text-muted":   { "$type": "color", "$value": "#6b7a8c", "$extensions": { "dark": "#9aa4b8" } },
    "text-faint":   { "$type": "color", "$value": "#94a1b2", "$extensions": { "dark": "#6d7890" } },
    "on-accent":    { "$type": "color", "$value": "#ffffff", "$extensions": { "dark": "#07101f" } },
    "accent":       { "$type": "color", "$value": "#2563eb", "$extensions": { "dark": "#6ea8fe" } },
    "accent-strong":{ "$type": "color", "$value": "#1d4ed8", "$extensions": { "dark": "#8dbbff" } },
    "accent-soft":  { "$type": "color", "$value": "#dbe7fd", "$extensions": { "dark": "rgba(110,168,254,0.14)" } },
    "green":        { "$type": "color", "$value": "#15803d", "$extensions": { "dark": "#7ee787" } },
    "green-soft":   { "$type": "color", "$value": "#dcf5e4", "$extensions": { "dark": "rgba(126,231,135,0.14)" } },
    "amber":        { "$type": "color", "$value": "#b45309", "$extensions": { "dark": "#f0883e" } },
    "amber-soft":   { "$type": "color", "$value": "#fdecd2", "$extensions": { "dark": "rgba(240,136,62,0.14)" } },
    "red":          { "$type": "color", "$value": "#b91c1c", "$extensions": { "dark": "#ff7b72" } },
    "red-soft":     { "$type": "color", "$value": "#fde3e3", "$extensions": { "dark": "rgba(255,123,114,0.14)" } },
    "slate":        { "$type": "color", "$value": "#64748b", "$extensions": { "dark": "#64748b" } },
    "slate-deep":   { "$type": "color", "$value": "#475569", "$extensions": { "dark": "#475569" } },
    "slate-soft":   { "$type": "color", "$value": "#e6ebf1", "$extensions": { "dark": "rgba(100,116,139,0.22)" } },
    "status": {
      "active":           { "$type": "color", "$value": "{color.green}" },
      "superseded":       { "$type": "color", "$value": "{color.slate}" },
      "retracted":        { "$type": "color", "$value": "{color.slate-deep}" },
      "provenance-stale": { "$type": "color", "$value": "{color.amber}" },
      "inconsistency":    { "$type": "color", "$value": "{color.red}" }
    },
    "badge": {
      "contested": { "$type": "color", "$value": "{color.amber}" },
      "hit":       { "$type": "color", "$value": "{color.accent}" }
    },
    "severity": {
      "error":   { "$type": "color", "$value": "{color.red}" },
      "warning": { "$type": "color", "$value": "{color.amber}" },
      "info":    { "$type": "color", "$value": "{color.accent}" }
    },
    "graph": {
      "node-border": { "$type": "color", "$value": "#48607c", "$extensions": { "dark": "#6f86a0" } },
      "edge":        { "$type": "color", "$value": "#7b8b9d", "$extensions": { "dark": "#8fa1b5" } },
      "edge-ghost":  { "$type": "color", "$value": "#aab6c2", "$extensions": { "dark": "#5b6b7d" } },
      "node-hue":    { "$type": "number", "$value": 214 },
      "node-l-weak":   { "$type": "dimension", "$value": "88%", "$extensions": { "dark": "22%" } },
      "node-l-strong": { "$type": "dimension", "$value": "48%", "$extensions": { "dark": "62%", "note": "fill L ramps weak→strong; inverts per theme so best-supported is always the higher-contrast end" } }
    }
  },
  "font": {
    "sans":    { "$type": "fontFamily", "$value": ["Inter", "ui-sans-serif", "system-ui", "-apple-system", "Segoe UI", "Roboto", "Helvetica", "Arial", "sans-serif"] },
    "mono":    { "$type": "fontFamily", "$value": ["JetBrains Mono", "ui-monospace", "SF Mono", "SFMono-Regular", "Menlo", "Consolas", "monospace"] },
    "display": { "$type": "fontFamily", "$value": "{font.sans}" },
    "size": {
      "xs":   { "$type": "dimension", "$value": "0.75rem" },
      "sm":   { "$type": "dimension", "$value": "0.8125rem" },
      "base": { "$type": "dimension", "$value": "0.9375rem" },
      "md":   { "$type": "dimension", "$value": "1rem" },
      "lg":   { "$type": "dimension", "$value": "1.125rem" },
      "xl":   { "$type": "dimension", "$value": "1.25rem" },
      "2xl":  { "$type": "dimension", "$value": "1.5rem" },
      "3xl":  { "$type": "dimension", "$value": "1.875rem" },
      "4xl":  { "$type": "dimension", "$value": "2.375rem" },
      "5xl":  { "$type": "dimension", "$value": "3rem" }
    },
    "leading": { "tight": { "$type": "number", "$value": 1.2 }, "snug": { "$type": "number", "$value": 1.35 }, "normal": { "$type": "number", "$value": 1.5 }, "prose": { "$type": "number", "$value": 1.65 } },
    "tracking": { "tight": { "$type": "dimension", "$value": "-0.015em" }, "wide": { "$type": "dimension", "$value": "0.02em" } },
    "weight": { "regular": { "$type": "fontWeight", "$value": 400 }, "medium": { "$type": "fontWeight", "$value": 500 }, "semibold": { "$type": "fontWeight", "$value": 600 }, "bold": { "$type": "fontWeight", "$value": 700 } }
  },
  "space": {
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" },
    "4": { "$type": "dimension", "$value": "16px" },
    "5": { "$type": "dimension", "$value": "24px" },
    "6": { "$type": "dimension", "$value": "32px" },
    "7": { "$type": "dimension", "$value": "48px" },
    "8": { "$type": "dimension", "$value": "64px" },
    "9": { "$type": "dimension", "$value": "96px" }
  },
  "radius": {
    "xs":   { "$type": "dimension", "$value": "4px" },
    "sm":   { "$type": "dimension", "$value": "6px" },
    "md":   { "$type": "dimension", "$value": "10px" },
    "lg":   { "$type": "dimension", "$value": "16px" },
    "xl":   { "$type": "dimension", "$value": "20px" },
    "pill": { "$type": "dimension", "$value": "999px" }
  },
  "layout": {
    "col-app":   { "$type": "dimension", "$value": "560px" },
    "col-wide":  { "$type": "dimension", "$value": "1100px" },
    "col-prose": { "$type": "dimension", "$value": "72ch" },
    "hairline":  { "$type": "dimension", "$value": "1px" }
  },
  "shadow": {
    "1": { "$type": "shadow", "$value": "0 1px 2px rgba(16,24,40,.06), 0 1px 3px rgba(16,24,40,.10)", "$extensions": { "dark": "0 1px 2px rgba(0,0,0,.35)" } },
    "2": { "$type": "shadow", "$value": "0 10px 30px rgba(16,24,40,.14)", "$extensions": { "dark": "0 10px 30px rgba(0,0,0,.35)" } }
  },
  "motion": {
    "ease":     { "$type": "cubicBezier", "$value": [0.2, 0, 0, 1] },
    "dur-fast": { "$type": "duration", "$value": "120ms" },
    "dur-base": { "$type": "duration", "$value": "180ms" },
    "dur-slow": { "$type": "duration", "$value": "280ms" }
  }
}
